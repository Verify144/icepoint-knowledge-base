+// retryableError 标记"这次失败可能是瞬时的，值得再试一次"。
+//
+// 存在的原因：网易 AuthV2 会间歇性返回 HTTP 200 + 空对象 {}（身份链为空）。
+// 原先这种情况被当作致命错误直接抛出，于是整个"进服"步骤变成了一次随机成败的调用。
+type retryableError struct{ err error }
+
+func (r retryableError) Error() string { return r.err.Error() }
+func (r retryableError) Unwrap() error { return r.err }
+
+// authV2Attempts 与 authV2Backoff 控制空链重试的节奏。
+// 总耗时上界约 0.7s + 抖动，远小于上层 90s 的上下文预算。
+const authV2Attempts = 4
+
+func authV2Backoff(attempt int) time.Duration {
+	d := 150 * time.Millisecond
+	for i := 1; i < attempt && i < 5; i++ {
+		d *= 2
+	}
+	return d
+}
+
+// RequestAuthV2Chain 获取身份链，对瞬时失败（含空链）做有限次退避重试。
 func (c *Client) RequestAuthV2Chain(ctx context.Context, serverID string, typ ServerType, clientPubKeyB64 string) ([]string, error) {
+	var lastErr error
+	for attempt := 1; attempt <= authV2Attempts; attempt++ {
+		chain, err := c.authV2Attempt(ctx, serverID, typ, clientPubKeyB64)
+		if err == nil {
+			if attempt > 1 {
+				debugLog("[AuthV2] 第 %d 次尝试成功", attempt)
+			}
+			return chain, nil
+		}
+		var retr retryableError
+		if !errors.As(err, &retr) {
+			return nil, err // 结构性错误，重试不会改变结果
+		}
+		lastErr = err
+		if attempt == authV2Attempts {
+			break
+		}
+		wait := authV2Backoff(attempt)
+		debugLog("[AuthV2] 第 %d 次失败(%v)，%s 后重试", attempt, err, wait)
+		select {
+		case <-time.After(wait):
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	return nil, fmt.Errorf("%w: 重试 %d 次仍失败: %v", ErrInvalidChain, authV2Attempts, lastErr)
+}
