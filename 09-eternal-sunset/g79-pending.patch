+// hashLibEntry 流式取回 library 内容并计算 MD5，返回十六进制字节。
+//
+// 这里的 MD5 是网易协议规定的內容哈希，不是安全签名摘要 —— 换成更强的哈希
+// 会直接算错签名，所以不能"顺手升级"。
+func hashLibEntry(apkURL string, entry cdEntry, dataStart, comp uint64) ([]byte, error) {
+	req, _ := http.NewRequest("GET", apkURL, nil)
+	req.Header.Set("User-Agent", "libhttpclient/1.0.0.0")
+	req.Header.Set("Range", fmt.Sprintf("bytes=%d-%d", dataStart, dataStart+comp-1))
+
+	resp, e := apkHTTPClient.Do(req)
+	if e != nil {
+		return nil, e
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusPartialContent && resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("HTTP %d", resp.StatusCode)
+	}
+
+	var src io.Reader = resp.Body
+	if entry.method == 8 {
+		fr := flate.NewReader(resp.Body)
+		defer fr.Close()
+		src = fr
+	} else if entry.method != 0 {
+		return nil, fmt.Errorf("不支持的压缩方式: %d", entry.method)
+	}
+
+	h := md5.New()
+	n, e := io.Copy(h, src)
+	if e != nil {
+		return nil, e
+	}
+	debugLog("[引擎] library 已读取 %d 字节，method=%d", n, entry.method)
+	sum := h.Sum(nil)
+	return sum, nil
 }
 
